{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kemet Download",
  "version": "0.1.0",
  "identifier": "com.kemet.download",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kemet Download",
        "width": 1000,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/deno"]
  }
}
